{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Puerto_Rico",
  "schedule": [
    "* 0-4 * * *"
  ],
  "automergeSchedule": [
    "* 0-4 * * *"
  ],
  "updateNotScheduled": false,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "automerge": false,
  "ignoreTests": false,
  "internalChecksAsSuccess": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": ["<tomcat\\.version>(?<currentValue>[^<\\s]+)</tomcat\\.version>"],
      "depNameTemplate": "org.apache.tomcat.embed:tomcat-embed-core",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "description": "Application images are advanced by the existing verified release workflow",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/javadevjt/**"
      ],
      "enabled": false
    },
    {
      "description": "Automerge tested dependencies through the protected GitHub CI check",
      "matchManagers": [
        "maven"
      ],
      "matchFileNames": [
        "pom.xml"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "matchCurrentVersion": "!/^0[.]/"
    },
    {
      "description": "Use the 11.0-series fix for CVE-2026-133325",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["maven"],
      "matchPackageNames": ["org.apache.tomcat.embed:tomcat-embed-core"],
      "allowedVersions": "[11.0.30,11.1)"
    },
    {
      "description": "Apply the existing tested Maven update policy to the embedded Tomcat override",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["maven"],
      "matchPackageNames": ["org.apache.tomcat.embed:tomcat-embed-core"],
      "matchFileNames": ["pom.xml"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0[.]/",
      "automerge": true
    }
  ],
  "platformCommit": "enabled"
}
